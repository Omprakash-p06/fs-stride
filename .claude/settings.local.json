{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/omprakash/.local/bin/graphicle' --data-dir '/home/omprakash/.local/share/graphicle' hook claude-code session-start",
            "timeout": 10
          }
        ],
        "matcher": "startup|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/omprakash/.local/bin/graphicle' --data-dir '/home/omprakash/.local/share/graphicle' hook claude-code stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/omprakash/.local/bin/graphicle' --data-dir '/home/omprakash/.local/share/graphicle' hook claude-code pre-compact",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/home/omprakash/.local/bin/graphicle' --data-dir '/home/omprakash/.local/share/graphicle' hook claude-code session-end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
